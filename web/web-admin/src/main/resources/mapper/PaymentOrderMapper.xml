<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.lease.web.admin.mapper.PaymentOrderMapper">

    <resultMap id="PaymentOrderItemMap"
        type="com.atguigu.lease.web.admin.vo.payment.PaymentOrderItemVo">
        <id property="id" column="id" />
        <result property="orderNo" column="order_no" />
        <result property="leaseAgreementId" column="lease_agreement_id" />
        <result property="tenantName" column="tenant_name" />
        <result property="tenantPhone" column="tenant_phone" />
        <result property="subject" column="subject" />
        <result property="amountTotal" column="amount_total" />
        <result property="balanceAmount" column="balance_amount" />
        <result property="wechatAmount" column="wechat_amount" />
        <result property="payMethod" column="pay_method" />
        <result property="status" column="status" />
        <result property="refundStatus" column="refund_status" />
        <result property="payChannel" column="pay_channel" />
        <result property="successTime" column="success_time" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <resultMap id="PaymentOrderDetailMap"
        type="com.atguigu.lease.web.admin.vo.payment.PaymentOrderDetailVo">
        <id property="id" column="id" />
        <result property="orderNo" column="order_no" />
        <result property="leaseAgreementId" column="lease_agreement_id" />
        <result property="tenantName" column="tenant_name" />
        <result property="tenantPhone" column="tenant_phone" />
        <result property="subject" column="subject" />
        <result property="amountTotal" column="amount_total" />
        <result property="balanceAmount" column="balance_amount" />
        <result property="wechatAmount" column="wechat_amount" />
        <result property="payMethod" column="pay_method" />
        <result property="status" column="status" />
        <result property="refundStatus" column="refund_status" />
        <result property="refundedAmount" column="refunded_amount" />
        <result property="payChannel" column="pay_channel" />
        <result property="h5Url" column="h5_url" />
        <result property="codeUrl" column="code_url" />
        <result property="successTime" column="success_time" />
        <result property="createTime" column="create_time" />
        <result property="leaseStatus" column="lease_status" />
        <result property="rent" column="rent" />
        <result property="deposit" column="deposit" />
        <result property="apartmentName" column="apartment_name" />
        <result property="roomNumber" column="room_number" />
    </resultMap>

    <!-- 分页查询支付订单列表 -->
    <select id="pageOrder" resultMap="PaymentOrderItemMap"> SELECT po.id, po.order_no,
        po.lease_agreement_id, po.subject, po.amount_total, po.balance_amount, po.wechat_amount,
        po.pay_method, po.status, po.refund_status, po.pay_channel, po.success_time, po.create_time,
        la.name AS tenant_name, la.phone AS tenant_phone FROM payment_order po LEFT JOIN
        lease_agreement la ON po.lease_agreement_id = la.id AND la.is_deleted = 0 <where>
        po.is_deleted = 0 <if test="queryVo != null">
                <if test="queryVo.orderNo != null and queryVo.orderNo != ''"> AND po.order_no LIKE
        CONCAT('%', #{queryVo.orderNo}, '%') </if>
                <if
                    test="queryVo.tenantName != null and queryVo.tenantName != ''"> AND la.name LIKE
        CONCAT('%', #{queryVo.tenantName}, '%') </if>
                <if
                    test="queryVo.tenantPhone != null and queryVo.tenantPhone != ''"> AND la.phone
        LIKE CONCAT('%', #{queryVo.tenantPhone}, '%') </if>
                <if test="queryVo.status != null"> AND
        po.status = #{queryVo.status} </if>
                <if test="queryVo.beginTime != null"> AND po.create_time
        &gt;= #{queryVo.beginTime} </if>
                <if test="queryVo.endTime != null"> AND po.create_time &lt;=
        #{queryVo.endTime} </if>
            </if>
        </where> ORDER BY po.create_time DESC </select>

    <!-- 根据ID查询支付订单详情 -->
    <select id="selectDetailById" resultMap="PaymentOrderDetailMap"> SELECT po.id, po.order_no,
        po.lease_agreement_id, po.subject, po.amount_total, po.balance_amount, po.wechat_amount,
        po.pay_method, po.status, po.refund_status, po.refunded_amount, po.pay_channel, po.h5_url,
        po.code_url, po.success_time, po.create_time, la.status AS lease_status, la.rent,
        la.deposit, la.name AS tenant_name, la.phone AS tenant_phone, ai.name AS apartment_name,
        ri.room_number FROM payment_order po LEFT JOIN lease_agreement la ON po.lease_agreement_id =
        la.id AND la.is_deleted = 0 LEFT JOIN room_info ri ON la.room_id = ri.id AND ri.is_deleted =
        0 LEFT JOIN apartment_info ai ON ri.apartment_id = ai.id AND ai.is_deleted = 0 WHERE
        po.is_deleted = 0 AND po.id = #{id} </select>

</mapper>